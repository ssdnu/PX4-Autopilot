# Apply/check these options on top of current boards/fts/fc-v5/nuttx-config.
# Names may differ slightly between PX4/NuttX releases; use menuconfig/qconfig.

CONFIG_ARCH_CHIP_STM32F765=y
CONFIG_STM32_FLASH_CONFIG_DEFAULT=y
CONFIG_BOARD_LOOPSPERMSEC=16717
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="boards/fts/fc-v5"

# HSE and system timer from hwdef
CONFIG_ARCH_BOARD_STM32_CUSTOM_CLOCKCONFIG=y
CONFIG_STM32_HSE_FREQUENCY=16000000
CONFIG_STM32_STM32F7_TIM5=y

# Peripherals used by hwdef
CONFIG_STM32_USART1=y
CONFIG_STM32_USART2=y
CONFIG_STM32_USART3=y
CONFIG_STM32_UART4=y
CONFIG_STM32_USART6=y
CONFIG_STM32_UART7=y
CONFIG_STM32_I2C1=y
CONFIG_STM32_I2C2=y
CONFIG_STM32_I2C3=y
CONFIG_STM32_I2C4=y
CONFIG_STM32_SPI1=y
CONFIG_STM32_SPI2=y
CONFIG_STM32_SPI4=y
CONFIG_STM32_CAN1=y
CONFIG_STM32_CAN2=y
CONFIG_STM32_SDMMC1=y
CONFIG_STM32_ADC1=y
CONFIG_STM32_TIM1=y
CONFIG_STM32_TIM2=y
CONFIG_STM32_TIM4=y
CONFIG_STM32_TIM8=y
CONFIG_STM32_TIM9=y
CONFIG_STM32_TIM12=y

# USB FS on PA11/PA12
CONFIG_STM32_OTGFS=y
CONFIG_CDCACM=y

# Filesystem / SD card
CONFIG_FS_FAT=y
CONFIG_FAT_LCNAMES=y
CONFIG_MMCSD=y

# PWM/RC/tone timers
CONFIG_STM32_TIM1_PWM=y
CONFIG_STM32_TIM2_PWM=y
CONFIG_STM32_TIM4_PWM=y
CONFIG_STM32_TIM8_CAP=y
CONFIG_STM32_TIM9_PWM=y
CONFIG_STM32_TIM12_PWM=y
