# SPI1
rm3100 -s -b 1 -R 0 start
if ! icm20649 -s -b 1 -R 2 -q start #ROTATION_YAW_90
then
	icm20689 -s -b 1 -R 2 -q start #ROTATION_NONE
fi

# SPI2


# SPI4
#bmi088 -s -b 4 -A -R 2 start
icm42688p -b 4 -R 2 -s start #ROTATION_YAW_90

ms5611 -s -b 4 start

# SPI6
#if ! icm20649 -s -b 6 -R 8 start #ROTATION_ROLL_180
#then
#	icm20689 -s -b 6 -R 0 start ##ROTATION_NONE
#fi
ms5611 -s -b 6 start

